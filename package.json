{
  "name": "diadeles-app",
  "version": "0.1.0",
  "description": "PWAs da Diadeles — educador e família, a partir da mesma base",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.educador.ts",
    "dev:educador": "vite --config vite.config.educador.ts",
    "dev:responsavel": "vite --config vite.config.responsavel.ts",
    "build": "pnpm build:site && pnpm build:educador && pnpm build:responsavel",
    "build:educador": "tsc -b && vite build --config vite.config.educador.ts",
    "build:responsavel": "tsc -b && vite build --config vite.config.responsavel.ts",
    "preview:educador": "vite preview --config vite.config.educador.ts",
    "preview:responsavel": "vite preview --config vite.config.responsavel.ts",
    "gen:api": "openapi-typescript http://localhost:3100/docs-json -o src/shared/api/schema.d.ts",
    "gen:icones": "node scripts/gerar-icones.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:site": "vite --config vite.config.site.ts",
    "build:site": "tsc -b && vite build --config vite.config.site.ts",
    "preview:site": "vite preview --config vite.config.site.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "date-fns": "^4.1.0",
    "dexie": "^4.0.10",
    "lucide-react": "^0.469.0",
    "openapi-fetch": "^0.13.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.10",
    "workbox-window": "^7.3.0"
  }
}
