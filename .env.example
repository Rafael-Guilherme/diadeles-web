# Estas variáveis são de **build**, não de runtime: o Vite troca
# `import.meta.env` por texto ao compilar. Em produção elas viram build
# arguments no Coolify — ver docs/deploy-coolify.md.

VITE_API_URL=http://localhost:3100

# A escola vem do endereço do app: app.diadeles.com.br/cantinho-feliz/…
# Esta é só a que a página inicial (sem escola no endereço) abre na primeira
# visita do aparelho — depois, ela abre a última escola usada.
VITE_ESCOLA=demonstracao

# Analytics do site institucional (Umami self-hosted). Só o site carrega; os
# apps nunca. Vazias = nada é carregado nem enviado.
VITE_ANALYTICS_URL=
VITE_ANALYTICS_SITE=

VITE_APP_EDUCADOR=http://localhost:5175
VITE_APP_RESPONSAVEL=http://localhost:5174

# Onde moram os termos de uso e a política de privacidade. A tela de entrada
# dos dois apps aponta para lá — é onde a pessoa concorda com eles.
VITE_SITE_URL=http://localhost:5176
